<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="ms-transfers"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- MDC completo (traceId/spanId los puebla Micrometer Tracing; userId/operationId
                 los pone UserHeaderAuthFilter/TransfersUseCase) se serializa automáticamente
                 como campos de primer nivel, sin necesidad de listarlos aquí. -->
            <customFields>{"service":"${appName}"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
